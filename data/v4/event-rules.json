      "domain": "relationship",
      "eventIds": [
        "rel_remarriage"
      ],
      "axisId": "major_relationship_count",
      "optionKeys": [
        "0",
        "1"
      ],
      "effect": "excluded",
      "maxLatestAge": 39,
      "rationale": "再次进入婚姻或长期稳定关系至少需要两段重要关系，长期关系总数不足两段时不成立。",
      "context": {
        "kind": "resolved_exclusive_group",
        "groupId": "mx.major_relationship_count",
        "allowedFactIds": [
          "fact.v4.axis.major_relationship_count.0",
          "fact.v4.axis.major_relationship_count.1"
