        "turn_close_death"
      ],
      "axisId": "first_close_loss",
      "optionKeys": [
        "none"
      ],
      "effect": "excluded",
      "maxLatestAge": 29,
      "rationale": "三十岁前未经历重要亲缘离世时，不成立完全落在该时段内的重要长辈或至亲离世。",
      "context": {
        "kind": "resolved_exclusive_group",
        "groupId": "mx.first_close_loss",
        "allowedFactIds": [
          "fact.v4.axis.first_close_loss.none"
        ]
      }
