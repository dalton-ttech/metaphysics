      "optionKeys": [
        "0"
      ],
      "effect": "excluded",
      "maxLatestAge": 39,
      "rationale": "连续一年以上的异地亲密关系属于持续一年以上的重要关系；后者为零时前者不成立。",
      "context": {
        "kind": "resolved_exclusive_group",
        "groupId": "mx.major_relationship_count",
        "allowedFactIds": [
          "fact.v4.axis.major_relationship_count.0"
